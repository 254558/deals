{
  "name": "deals",
  "version": "1.0.0",
  "description": "比价与捡漏工具：记录各家零售商的上市价与现价，找出降价最狠的商品（优衣库 / 迪卡侬）",
  "type": "module",
  "bin": {
    "deals": "./src/cli.mjs"
  },
  "scripts": {
    "sites": "node src/cli.mjs sites",
    "sync": "node src/cli.mjs all sync",
    "sync:uniqlo": "node src/cli.mjs uniqlo sync",
    "list": "node src/cli.mjs uniqlo list",
    "report": "node src/cli.mjs all report",
    "report:uniqlo": "node src/cli.mjs uniqlo report",
    "dev:uniqlo": "node src/cli.mjs uniqlo dev",
    "build": "vite build",
    "deploy:uniqlo": "node src/cli.mjs uniqlo deploy",
    "deploy:cloudflare": "node src/cli.mjs all deploy --target cloudflare",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "pretest": "eslint . && node scripts/check-vue.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "dependencies": {
    "lucide-react": "^1.48.0",
    "lucide-vue-next": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "vite": "^5.4.21"
  }
}
